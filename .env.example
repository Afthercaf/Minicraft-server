# ===== COPIA ESTE ARCHIVO A .env Y RELLENA LOS VALORES =====
# NUNCA subas el .env a git. Genera claves largas y aleatorias.

# Clave RCON del servidor Minecraft (minimo 32 caracteres aleatorios)
RCON_PASSWORD=cambia-esto-por-una-clave-larga-y-aleatoria

# Panel visual (backend local)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://minicraft-server-z7uz.onrender.com
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
SUPERADMIN_EMAIL=tu-correo@ejemplo.com
SERVER_DATA_PATH=../server-data
DOCKER_CONTAINER=mc-forge
REDIS_PASSWORD=genera-una-clave-aleatoria-de-64-caracteres
REDIS_URL=redis://:la-misma-clave@127.0.0.1:6379

# Clave compartida entre el backend de Render y el agente local (minimo 32 caracteres)
AGENT_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria

# Versiones
MC_VERSION=1.20.1
FORGE_VERSION=

# Recursos y limites
MC_MEMORY=4G
MAX_PLAYERS=10

# Seguridad del juego
ONLINE_MODE=true
ENABLE_WHITELIST=true
# Lista inicial de jugadores permitidos, separados por comas (vacio = nadie)
WHITELIST_PLAYERS=

# General
MOTD=Servidor Privado
DIFFICULTY=normal
SPAWN_PROTECTION=16
TZ=America/Mexico_City
